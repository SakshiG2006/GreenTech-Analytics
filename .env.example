# Copy values into local/cloud environment; never commit real secrets.
OPENWEATHER_API_KEY=
CLIMATE_CSV_PATH=./data/climate.csv
CSV_CITY_COLUMN=Country
CSV_DATE_COLUMN=Date
CSV_TEMP_COLUMN=AverageTemperature
CSV_CO2_COLUMN=CO2
# Configure all three for OAuth/OIDC JWT validation.
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URL=
# Set true to require authentication if no OAuth settings are configured.
AUTH_REQUIRED=true
